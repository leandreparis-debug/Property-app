{
  "name": "vigie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vigie — référentiel interne des entrepôts logistiques Carrefour Property",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:offline": "tsx scripts/check-no-external.ts",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:sql": "bash scripts/db-sql.sh",
    "user:create": "tsx --conditions=react-server scripts/user-create.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/user-reset-password.ts",
    "user:set-active": "tsx --conditions=react-server scripts/user-set-active.ts",
    "import:spreadsheet": "tsx --conditions=react-server scripts/import-spreadsheet.ts",
    "sample:build": "tsx scripts/build-sample-spreadsheet.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:offline && pnpm build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-mssql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "jsdom": "^30.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "exceljs>uuid": "^11.1.1"
    }
  }
}
