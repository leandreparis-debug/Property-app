MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
DATABASE_URL="sqlserver://localhost:1433;database=vigie;user=sa;password=ChangeMe_Str0ng!;trustServerCertificate=true"
APP_URL=http://localhost:3000


# Sessions. COOKIE_SECURE defaults to true in production and false otherwise;
# true requires HTTPS (Secure cookie with the __Host- prefix).
# COOKIE_SECURE=true
SESSION_IDLE_MINUTES=240
SESSION_ABSOLUTE_HOURS=12
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Root folder of the files written by the application (import reports,
# documents). Default ./storage outside production; required in production.
STORAGE_ROOT=./storage

# Basemap: ign (default) = Plan IGN and aerial photographs of the IGN
# Géoplateforme, loaded online by each user's browser (the workstations must
# reach data.geopf.fr); offline = offline bundle installed on the server, or
# the fallback style (closed network).
MAP_BASEMAP=ign

# Operations scheduler (nightly export, purges): on | off. Default: off when
# NODE_ENV=test, on otherwise. The e2e suite forces off.
# OPS_SCHEDULER=on
# Time of the daily jobs, HH:MM, Europe/Paris time zone (daylight-saving aware).
OPS_DAILY_AT=03:30
